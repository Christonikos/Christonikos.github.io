---
import Base from "../layouts/Base.astro";
import PublicationRow from "../components/PublicationRow.astro";
import PublicationsToc from "../components/PublicationsToc.astro";
import { site, links } from "../data/site";
import { publicationDomains } from "../data/publications";
---

<Base
  title={`Publications | ${site.name}`}
  description="Publications and conference contributions in clinical AI, biosignals, neuroimaging, and biomedical NLP."
  path="/publications/"
>
  <header class="page-header">
    <h1 class="display">Publications</h1>
    <p>
      Peer-reviewed papers, clinical abstracts, and conference posters spanning
      clinically validated biosignal ML, cognitive neuroscience and language
      processing, and language-model evaluation. Full list on{" "}
      <a href={links.scholar}>Google Scholar</a>.
    </p>
  </header>

  <PublicationsToc />

  {
    publicationDomains.map((domain) => (
      <section
        id={`domain-${domain.id}`}
        class="page-section pub-domain"
        aria-labelledby={`domain-heading-${domain.id}`}
      >
        <h2 id={`domain-heading-${domain.id}`} class="display pub-domain-title">
          {domain.title}
        </h2>
        <p class="pub-domain-intro">{domain.intro}</p>
        {
          domain.groups.map((group) => (
            <section
              id={`group-${group.id}`}
              class="pub-group"
              aria-labelledby={`group-heading-${group.id}`}
            >
              <h3 id={`group-heading-${group.id}`} class="pub-group-title">
                {group.title}
              </h3>
              <p class="pub-group-intro">{group.intro}</p>
              <div class="pub-list">
                {group.items.map((pub) => (
                  <PublicationRow pub={pub} />
                ))}
              </div>
            </section>
          ))
        }
      </section>
    ))
  }

  <p class="text-link-row">
    <a href="/">← Home</a>
  </p>
</Base>
